<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Warstwa: gradientowa ramka -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CDFFCFD2"
                android:centerColor="#BAFBFDCF"
                android:endColor="#A6B9FBC0"
                android:angle="45" />
            <corners android:radius="15dp" />
        </shape>
    </item>

    <!-- Warstwa: wnętrze z przezroczystym tłem -->
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#ffffff" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</layer-list>
