                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/liquids"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>


            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_meals"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meals"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/meals"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>


            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_meat"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meat"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/meat"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>


            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_milk"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mixed"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/mixed"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>


            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_tomato"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetables"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/vegetables"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>


            <TextView
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diet"
                android:textColor="#C3000000"
                android:textSize="24dp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_fish"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetarian"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/vegetarian"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_vegetables"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegan"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/vegan"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
        </LinearLayout>


    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="25dp"
        android:background="@drawable/bg_bottom_panel"
        android:elevation="6dp">

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/resetbtn"
    android:text="@string/underlined_text"
    android:textColor="@color/black"
    android:textSize="16dp"/>


        <com.google.android.material.button.MaterialButton
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="Filter"
            android:textSize="17dp"
            android:id="@+id/filterbtn"
            android:layout_marginStart="30dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/green"
            app:iconTint="@android:color/white"
            android:elevation="8dp"
        />
    </LinearLayout>
</LinearLayout>
