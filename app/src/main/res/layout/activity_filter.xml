<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:orientation="vertical"
  >
    <LinearLayout
        android:paddingVertical="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="6dp">
        <ImageView
            android:id="@+id/arrowback"
            android:layout_marginStart="25dp"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@drawable/ic_arrow_back"/>
       <TextView
           android:layout_width="0dp"
           android:layout_weight="1"
           android:gravity="center"
           android:layout_marginEnd="60dp"
           android:layout_gravity="center"
           android:layout_height="wrap_content"
           android:textColor="#C3000000"
           android:textSize="25dp"
           android:textStyle="bold"
           android:text="Filters"/>
    </LinearLayout>
    <ScrollView
        android:scrollbars="none"
        android:paddingHorizontal="40dp"
        android:layout_marginTop="23dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Collection day"
                android:textStyle="bold"
                android:textColor="#C3000000"
                android:textSize="15dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="49dp"
                    android:text="Today"
                    android:textSize="15dp"
                    android:id="@+id/todayfltr"
                    android:textAllCaps="false"
                    android:textColor="@color/brown"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#FFFFFF"
                    android:elevation="8dp"
                    />
                <Space
                    android:layout_width="10dp"
                    android:layout_height="2dp"/>
                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="49dp"
                    android:text="Tomorrow"
                    android:textSize="15dp"
                    android:id="@+id/tomorrowfltr"
                    android:textAllCaps="false"
                    android:textColor="@color/brown"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#ffffff"
                    android:elevation="8dp"
                    />
            </LinearLayout>

            <TextView
                android:layout_marginTop="12dp"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Collection time"
                android:textStyle="bold"
                android:textColor="#C3000000"
                android:textSize="15dp"/>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/timeRangeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="1439"
                android:stepSize="1"
                />




            <TextView
                android:layout_marginBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Food type"
                android:textColor="#C3000000"
                android:textSize="24dp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_marginVertical="12dp"
                android:id="@+id/checkboxGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="27dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_sweets"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sweets"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:id="@+id/sweets"
                    android:layout_width="30dp"
                    android:buttonTint="@color/hint_color"
                    android:layout_height="30dp" />
            <!--    <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/materialCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Option 1"
                    app:checkboxTint="@color/yellow" />-->

            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_fastfoods"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fast foods"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/fastfoods"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_bakery"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bakery"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/bakery"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_dairy"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dairy"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/dairy"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>



            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_fruits"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fruits"
                    android:textSize="16dp"
                    android:textColor="#232323"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <CheckBox
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:buttonTint="@color/hint_color"
                    android:id="@+id/fruits"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>


            <LinearLayout
                android:layout_marginVertical="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_liquids"/>
                <TextView
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
