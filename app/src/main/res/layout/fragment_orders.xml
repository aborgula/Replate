<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- ScrollView z zamówieniami -->
    <ScrollView
        android:layout_marginTop="40dp"
        android:id="@+id/ordersScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/ordersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:showDividers="middle"
            android:dividerPadding="8dp"/>
    </ScrollView>

    <!-- Pusty stan -->
    <LinearLayout
        android:id="@+id/emptyOrdersLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emptyOrdersAnimation"
            android:layout_width="250dp"
            android:layout_height="250dp"
            app:lottie_rawRes="@raw/noorders"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/emptyOrdersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No orders yet — time to grab your first one!"
            android:textSize="19dp"
            android:textStyle="bold"
            android:paddingHorizontal="56dp"
            android:textColor="@android:color/black"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAlignment="center"/>

    </LinearLayout>
</FrameLayout>
