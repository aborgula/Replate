<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentMap">

    <!-- Mapa -->
    <fragment
        android:id="@+id/map_fragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layout pustego stanu (domyślnie schowany) -->
    <LinearLayout
        android:id="@+id/layoutEmptyMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="100dp"
        android:visibility="gone"
        >

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emptyMapAnim"
            android:layout_width="250dp"
            android:layout_height="250dp"
            app:lottie_rawRes="@raw/nopackagesanimation"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/emptyParcelsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No parcels available right now… check back later!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:paddingHorizontal="56dp"/>
    </LinearLayout>

</FrameLayout>
