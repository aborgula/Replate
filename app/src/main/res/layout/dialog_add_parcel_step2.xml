<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="24dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/sweets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sweets"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_sweets"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />
        <com.google.android.material.chip.Chip
            android:id="@+id/fastfood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fast food"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_fastfoods"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bakery"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bakery"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_bakery"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/dairy"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Dairy"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_dairy"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="19dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/vegetables"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Vegetables"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_tomato"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="-2dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/vegetarian"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Vegetarian"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_fish"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="-2dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/vegan"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Vegan"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_vegetables"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="-2dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/fruits"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Fruits"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_fruits"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/liquids"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Liquids"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_liquids"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="-4dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/meals"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Meals"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_meals"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/meat"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Meat"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_meat"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="-1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="22dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/mixed"
            style="@style/BoldTextChip"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:text="Mixed"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:checkable="true"
            app:chipIcon="@drawable/ic_milk"
            app:chipIconVisible="true"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/gold"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/gold"
            app:iconStartPadding="12dp"
            app:iconEndPadding="1dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="4dp"
            app:chipIconSize="23dp" />

    </com.google.android.material.chip.ChipGroup>



    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="25dp"
        android:background="@drawable/bg_bottom_panel"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/back"
            android:text="@string/underlined_back"
            android:textColor="@color/black"
            android:textSize="16dp"/>


        <com.google.android.material.button.MaterialButton
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:text="Next"
            android:textSize="17dp"
            android:id="@+id/next"
            android:layout_marginStart="30dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/green"
            app:iconTint="@android:color/white"
            android:elevation="8dp"
            />
    </LinearLayout>

</LinearLayout>
