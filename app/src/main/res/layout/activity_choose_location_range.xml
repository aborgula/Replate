<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_marginTop="@dimen/margin_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ChooseLocationRangeActivity">

    <!-- Mapa jako tło -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Górny pasek -->
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:elevation="4dp">

        <Space
            android:layout_width="24dp"
            android:layout_height="match_parent" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textSize="17dp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="Choose a location to see\n what's available" />
        <ImageButton
            android:id="@+id/closebtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="20dp"
            android:scaleX="1.6"
            android:scaleY="1.6"
            android:src="@drawable/ic_close"
            android:background="@null"
            android:tint="#D5D5D5" />
    </LinearLayout>

    <!-- Zaokrąglony dolny baner -->
    <LinearLayout
        android:id="@+id/slideup"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_gravity="bottom"
        android:background="@drawable/background_choose_location"
        android:orientation="vertical"
        android:elevation="8dp"
        android:layout_marginTop="38dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a distance"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"/>
        <com.google.android.material.slider.Slider
            android:layout_marginHorizontal="25dp"
            android:id="@+id/distanceSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="20"
            android:stepSize="1"
            app:labelBehavior="floating"/>

        <AutoCompleteTextView
            android:id="@+id/searchcity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_search_city"
            android:hint="Search for a city"
            android:paddingLeft="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:gravity="center_vertical|start"
            android:layout_marginHorizontal="25dp"
            android:paddingVertical="11dp"/>


        <LinearLayout
            android:layout_marginVertical="18dp"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content" >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_navigation"
                android:tint="@color/slider_thumb_color"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:id="@+id/usecurrentlocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use my current location"
                android:textStyle="bold"
                android:drawableTint="@color/slider_thumb_color"
                android:textSize="14dp"
                android:textColor="@color/slider_thumb_color"
                android:gravity="center" />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/showresultbtn"
            android:layout_gravity="center_horizontal"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="@android:color/transparent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/btn_show_results"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show Results"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </LinearLayout>
</FrameLayout>
