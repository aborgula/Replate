<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/mainbackground">
<LinearLayout

  android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbackground">
    <ImageView
        android:layout_marginTop="60dp"
        android:layout_width="170dp"
        android:layout_height="70dp"
        android:src="@drawable/replatedarknarrower"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't bin it. Replate it."
        android:textSize="17dp"/>

    <LinearLayout
        android:visibility="visible"
        android:id="@+id/slideup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="36dp"
        android:background="@drawable/login_banner_background"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="33dp"
            android:text="Create your account"
            android:textColor="@color/black"
            android:textSize="30dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:text="Turn leftovers into new beginnings."
            android:textColor="#808080"
            android:orientation="vertical"
            android:textSize="16dp"
            />

        <LinearLayout
            android:layout_marginStart="35dp"
            android:layout_marginTop="37dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <ImageView
                app:tint="@color/brown"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_login"/>

            <EditText
                android:background="@null"
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="27dp"
                android:hint="Jimmyc02"
                android:textSize="21dp" />
        </LinearLayout>
        <View
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="30dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />
        <LinearLayout
            android:layout_marginStart="35dp"
            android:layout_marginTop="25dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <ImageView
                android:layout_width="30dp"
                android:layout_height="32dp"
                android:src="@drawable/baseline_mail_outline_24"/>
            <EditText
                android:background="@null"
                android:id="@+id/mail"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="jimmyckr@gmail.com"
                android:layout_marginStart="27dp"
                android:textSize="21dp"/>
        </LinearLayout>
        <View
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="30dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />
        <LinearLayout
            android:layout_marginStart="35dp"
            android:layout_marginTop="25dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <ImageView
                app:tint="@color/brown"
                android:layout_width="30dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_locker"/>
            <EditText
                android:background="@null"
                android:id="@+id/password"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:layout_marginStart="27dp"
                android:textSize="20dp"/>
        </LinearLayout>
        <View
            android:layout_marginVertical="12dp"
            android:layout_marginHorizontal="30dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />




        <androidx.cardview.widget.CardView
            android:id="@+id/registerbtn"
            android:layout_gravity="center_horizontal"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="@android:color/transparent"
android:layout_marginTop="10dp"            android:layout_marginBottom="20dp"
          >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/brown_btn"
                android:paddingHorizontal="16dp"
                android:paddingVertical="15dp">

                <TextView
                    android:layout_marginStart="15dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="REGISTER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <ImageView
                    android:layout_marginEnd="15dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_forward"
                android:contentDescription="Arrow"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_marginHorizontal="60dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#BDBDBD" /> <!-- szarość linii -->

            <TextView
                android:textSize="13dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="     Continue with     "
                 />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#BDBDBD" />
        </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="30dp">

                    <LinearLayout
                        android:id="@+id/googleregistration"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/register_icons_background"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:src="@drawable/ic_google"
                            android:scaleX="0.8"
                            android:scaleY="0.8"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            />
                    </LinearLayout>
<Space
    android:layout_width="20dp"
    android:layout_height="match_parent"/>

                    <LinearLayout
                        android:id="@+id/phoneregistration"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/register_icons_background"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:src="@drawable/ic_phon"
                            android:scaleX="1.2"
                            android:scaleY="1.2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            />
                    </LinearLayout>

            </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account?"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/signinbtn"
            android:layout_gravity="center_horizontal"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:layout_margin="8dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#F7D90E"
                android:paddingHorizontal="16dp"
                android:paddingVertical="15dp">

                <TextView
                    android:textAlignment="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="SIGN IN"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>



    </LinearLayout>

</LinearLayout>

</ScrollView>